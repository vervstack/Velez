{
  "swagger": "2.0",
  "info": {
    "title": "runners_api.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "RunnersAPI",
      "description": "RunnersAPI - Runners-as-a-Service. A runner is a normal Velez service\n(velez.services / deployment_specifications / deployments), with only the\nrunner-specific facts (provider, scope, target, labels, secret_ref) held in\nvelez.runners. Git-agnostic by design: GitHub Actions is the first\nRunnerProvider, GitLab and others are additional providers under this same\ncontract, not separate contracts. Structured after PostgresAPI."
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/api/runners/create": {
      "post": {
        "operationId": "RunnersAPI_CreateRunner",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/velez_apiCreateRunnerResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/googleRpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/velez_apiCreateRunnerRequest"
            }
          }
        ],
        "tags": [
          "RunnersAPI"
        ]
      }
    },
    "/api/runners/drop": {
      "post": {
        "operationId": "RunnersAPI_DropRunner",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/velez_apiDropRunnerResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/googleRpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/velez_apiDropRunnerRequest"
            }
          }
        ],
        "tags": [
          "RunnersAPI"
        ]
      }
    },
    "/api/runners/list": {
      "post": {
        "operationId": "RunnersAPI_ListRunners",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/velez_apiListRunnersResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/googleRpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/velez_apiListRunnersRequest"
            }
          }
        ],
        "tags": [
          "RunnersAPI"
        ]
      }
    },
    "/api/runners/redeploy": {
      "post": {
        "summary": "RedeployRunner recreates the runner's container from its current stored\ndeployment spec, overlaying docker_socket_address as DOCKER_HOST (or\nclearing it back to unset) - the only way a docker_socket_address change\never reaches the container, since it's a deploy-time env var, not\nsomething a running container can pick up. Mirrors ReregisterRunner's\nfire-and-forget shape.",
        "operationId": "RunnersAPI_RedeployRunner",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/velez_apiRedeployRunnerResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/googleRpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/velez_apiRedeployRunnerRequest"
            }
          }
        ],
        "tags": [
          "RunnersAPI"
        ]
      }
    },
    "/api/runners/reregister": {
      "post": {
        "summary": "ReregisterRunner unregisters and re-registers the runner's existing\ncontainer in place, reusing its already-stored registration token - no\nnew token minted, no new container deployed. A no-op unregister/register\nfor a self-registering provider (GitHub).",
        "operationId": "RunnersAPI_ReregisterRunner",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/velez_apiReregisterRunnerResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/googleRpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/velez_apiReregisterRunnerRequest"
            }
          }
        ],
        "tags": [
          "RunnersAPI"
        ]
      }
    },
    "/api/runners/set_buildkit": {
      "post": {
        "summary": "SetRunnerBuildkit adds or removes the runner's BuildKit sidecar\nasynchronously; the response carries the id of the set_runner_buildkit\ntask.",
        "operationId": "RunnersAPI_SetRunnerBuildkit",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/velez_apiSetRunnerBuildkitResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/googleRpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/velez_apiSetRunnerBuildkitRequest"
            }
          }
        ],
        "tags": [
          "RunnersAPI"
        ]
      }
    },
    "/api/runners/update_config": {
      "post": {
        "summary": "UpdateRunnerConfig persists new provider config values. It never applies\nthem to the running container - the response tells the caller which\nfollow-up action does: requires_reregister (base_url/docker_image, via\nReregisterRunner) and/or requires_redeploy (docker_socket_address, via\nRedeployRunner). pull_policy, allowed_pull_policies, check_interval,\nlog_level and shutdown_timeout apply immediately to the runner's\nconfig.toml and need neither.",
        "operationId": "RunnersAPI_UpdateRunnerConfig",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/velez_apiUpdateRunnerConfigResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/googleRpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/velez_apiUpdateRunnerConfigRequest"
            }
          }
        ],
        "tags": [
          "RunnersAPI"
        ]
      }
    },
    "/api/runners/{name}/config": {
      "get": {
        "summary": "GetRunnerConfig reads the runner's currently stored provider config\n(base_url, docker_image, docker_socket_address) - the values the next\nReregisterRunner/RedeployRunner call will apply, not necessarily what\nthe running container was deployed with. pull_policy,\nallowed_pull_policies, check_interval, log_level and shutdown_timeout are\nthe exception: they are read live from the runner's config.toml.",
        "operationId": "RunnersAPI_GetRunnerConfig",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/velez_apiGetRunnerConfigResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/googleRpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "RunnersAPI"
        ]
      }
    },
    "/api/runners/{name}/credentials": {
      "get": {
        "summary": "GetRunnerCredentials is the only RPC that resolves a secret_ref to its\nvalue.",
        "operationId": "RunnersAPI_GetRunnerCredentials",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/velez_apiGetRunnerCredentialsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/googleRpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "RunnersAPI"
        ]
      }
    }
  },
  "definitions": {
    "ProvisioningTaskJob": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/velez_apiProvisioningTaskStatus"
        }
      }
    },
    "googleRpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "velez_apiCreateRunnerRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "scope": {
          "$ref": "#/definitions/velez_apiRunnerScope"
        },
        "target": {
          "type": "string"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "environment": {
          "type": "string"
        },
        "dockerSocketAddress": {
          "type": "string",
          "description": "docker_socket_address - tcp:// address of a Docker daemon this runner\nshould talk to (set as DOCKER_HOST env) instead of the default host\nsocket. unix:// and bare paths are rejected: no caller-supplied value\nmay ever become a bind-mount source, so it can never be pointed at\nVelez's own host socket. Empty means Velez grants the host socket via\nits existing internal-only bind-mount gate - full root access, the\ncurrent default behavior."
        },
        "github": {
          "$ref": "#/definitions/velez_apiGithubConfig"
        },
        "gitlab": {
          "$ref": "#/definitions/velez_apiGitlabConfig"
        },
        "dindName": {
          "type": "string",
          "description": "dind_name - name of a DinD service (DindAPI) the runner uses as its Docker daemon. New runners must set exactly one of dind_name or docker_socket_address; neither is rejected."
        },
        "isBuildkitEnabled": {
          "type": "boolean",
          "description": "is_buildkit_enabled - provision a BuildKit sidecar for the runner."
        }
      }
    },
    "velez_apiCreateRunnerResponse": {
      "type": "object",
      "properties": {
        "runner": {
          "$ref": "#/definitions/velez_apiRunner",
          "description": "runner is never populated - the RPC enqueues the create_runner task\nand returns before it completes. Callers watch entity_id/action via\nTasksApi.WatchTask and refetch ListRunners once the task reaches DONE."
        },
        "entityId": {
          "type": "string"
        },
        "action": {
          "type": "string"
        }
      }
    },
    "velez_apiDropRunnerRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      }
    },
    "velez_apiDropRunnerResponse": {
      "type": "object"
    },
    "velez_apiGetRunnerConfigResponse": {
      "type": "object",
      "properties": {
        "baseUrl": {
          "type": "string"
        },
        "dockerImage": {
          "type": "string"
        },
        "dockerSocketAddress": {
          "type": "string"
        },
        "concurrent": {
          "type": "integer",
          "format": "int32"
        },
        "pullPolicy": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/velez_apiRunnerPullPolicy"
          },
          "description": "The fields below are read live from the runner's config.toml;\nempty / 0 / UNSPECIFIED means the key is unset.\npull_policy - ordered fallback chain."
        },
        "allowedPullPolicies": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/velez_apiRunnerPullPolicy"
          }
        },
        "checkInterval": {
          "type": "integer",
          "format": "int32"
        },
        "logLevel": {
          "$ref": "#/definitions/velez_apiRunnerLogLevel"
        },
        "shutdownTimeout": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "velez_apiGetRunnerCredentialsResponse": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "description": "token - the provider registration token stored at CreateRunner time\n(GitHub: minted from the caller's PAT; GitLab: the caller's access\ntoken, trusted as-is). Not re-mintable through this RPC; it reflects\nthe token stored then."
        },
        "target": {
          "type": "string",
          "description": "target - the repo/org (or project/group) the token registers against."
        },
        "provider": {
          "$ref": "#/definitions/velez_apiRunnerProvider"
        }
      }
    },
    "velez_apiGithubConfig": {
      "type": "object",
      "properties": {
        "accessToken": {
          "type": "string",
          "description": "access_token - a GitHub PAT with permission to mint a runner\nregistration token for target. Never stored as given; see\ninternal/service/secrets."
        }
      },
      "description": "GithubConfig - GitHub Actions-specific CreateRunner body."
    },
    "velez_apiGitlabConfig": {
      "type": "object",
      "properties": {
        "accessToken": {
          "type": "string",
          "description": "access_token - a GitLab runner registration token for target (project or\ngroup), created by the caller ahead of time. Never stored as given; see\ninternal/service/secrets."
        },
        "baseUrl": {
          "type": "string",
          "description": "base_url - the GitLab instance's base URL, e.g. \"https://gitlab.com\" or\na self-managed instance's URL. Empty defaults to \"https://gitlab.com\"."
        },
        "dockerImage": {
          "type": "string",
          "title": "docker_image - the image `gitlab-runner register`'s docker executor uses\nfor job containers"
        },
        "concurrent": {
          "type": "integer",
          "format": "int32",
          "description": "concurrent - the global gitlab-runner `concurrent` setting: how many jobs\nthe runner runs at once. Unset defaults to 1."
        }
      },
      "description": "GitlabConfig - GitLab-specific CreateRunner body. access_token is trusted\nas an already-valid registration token (GitLab's own minting API is\ndeprecated/disabled on modern instances, see runneraas/providers/gitlab),\nthen handed to `gitlab-runner register`, run automatically against the\ndeployed container."
    },
    "velez_apiListRunnersRequest": {
      "type": "object",
      "properties": {
        "paging": {
          "$ref": "#/definitions/velez_apiPaging"
        }
      }
    },
    "velez_apiListRunnersResponse": {
      "type": "object",
      "properties": {
        "runners": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/velez_apiRunner"
          }
        },
        "total": {
          "type": "string",
          "format": "uint64"
        },
        "provisioning": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/velez_apiProvisioningTask"
          }
        }
      }
    },
    "velez_apiPaging": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "string",
          "format": "uint64"
        },
        "offset": {
          "type": "string",
          "format": "uint64"
        }
      }
    },
    "velez_apiProvisioningTask": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string",
          "format": "int64"
        },
        "entityId": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/velez_apiProvisioningTaskStatus"
        },
        "error": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "jobs": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/ProvisioningTaskJob"
          }
        }
      },
      "description": "ProvisioningTask is an in-flight or recently failed create task of an AsAService\ninstance. List*Instances responses carry these so the UI can show provisioning\nprogress that survives a reload. Active until its task is DONE; FAILED ones stay\nuntil dismissed or 5 minutes old."
    },
    "velez_apiProvisioningTaskStatus": {
      "type": "string",
      "enum": [
        "STATUS_UNSPECIFIED",
        "PENDING",
        "RUNNING",
        "DONE",
        "FAILED"
      ],
      "default": "STATUS_UNSPECIFIED"
    },
    "velez_apiRedeployRunnerRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      }
    },
    "velez_apiRedeployRunnerResponse": {
      "type": "object",
      "properties": {
        "entityId": {
          "type": "string"
        },
        "action": {
          "type": "string"
        }
      }
    },
    "velez_apiReregisterRunnerRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      }
    },
    "velez_apiReregisterRunnerResponse": {
      "type": "object",
      "properties": {
        "entityId": {
          "type": "string"
        },
        "action": {
          "type": "string"
        }
      }
    },
    "velez_apiRunner": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "provider": {
          "$ref": "#/definitions/velez_apiRunnerProvider"
        },
        "scope": {
          "$ref": "#/definitions/velez_apiRunnerScope"
        },
        "target": {
          "type": "string",
          "description": "target - the repo (\"owner/repo\") or org (\"owner\") the runner registers\nagainst, per scope."
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "environment": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "isBuildkitEnabled": {
          "type": "boolean",
          "description": "is_buildkit_enabled - whether the runner has a BuildKit sidecar. Derived\nfrom the sidecar itself; there is no separate stored flag."
        }
      },
      "description": "Runner never carries its access token - status and environment live on the\nunderlying service/deployment rows and are read via ListSmerds/\nVervServicesService, not duplicated here."
    },
    "velez_apiRunnerLogLevel": {
      "type": "string",
      "enum": [
        "RUNNER_LOG_LEVEL_UNSPECIFIED",
        "RUNNER_LOG_LEVEL_DEBUG",
        "RUNNER_LOG_LEVEL_INFO",
        "RUNNER_LOG_LEVEL_WARN",
        "RUNNER_LOG_LEVEL_ERROR",
        "RUNNER_LOG_LEVEL_FATAL",
        "RUNNER_LOG_LEVEL_PANIC"
      ],
      "default": "RUNNER_LOG_LEVEL_UNSPECIFIED",
      "description": "RunnerLogLevel - gitlab-runner global log_level value."
    },
    "velez_apiRunnerProvider": {
      "type": "string",
      "enum": [
        "RUNNER_PROVIDER_UNSPECIFIED",
        "GITHUB",
        "GITLAB"
      ],
      "default": "RUNNER_PROVIDER_UNSPECIFIED",
      "description": "RunnerProvider - which CI system a runner registers against. GITHUB\nself-registers fully from env vars; GITLAB registers via an automated\n`gitlab-runner register` exec against the deployed container. Others are\nadded here as new values later, never as new contracts."
    },
    "velez_apiRunnerPullPolicies": {
      "type": "object",
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/velez_apiRunnerPullPolicy"
          }
        }
      },
      "description": "RunnerPullPolicies wraps a repeated field so UpdateRunnerConfig can tell \"unset\" from \"clear\"."
    },
    "velez_apiRunnerPullPolicy": {
      "type": "string",
      "enum": [
        "RUNNER_PULL_POLICY_UNSPECIFIED",
        "RUNNER_PULL_POLICY_ALWAYS",
        "RUNNER_PULL_POLICY_IF_NOT_PRESENT",
        "RUNNER_PULL_POLICY_NEVER"
      ],
      "default": "RUNNER_PULL_POLICY_UNSPECIFIED",
      "description": "RunnerPullPolicy - gitlab-runner docker executor pull_policy value."
    },
    "velez_apiRunnerScope": {
      "type": "string",
      "enum": [
        "RUNNER_SCOPE_UNSPECIFIED",
        "REPO",
        "ORG"
      ],
      "default": "RUNNER_SCOPE_UNSPECIFIED",
      "description": "RunnerScope - the scope a self-hosted runner registers under: a single\nrepository, or an entire organization/group. Generalizes across providers\n(GitHub repo/org, GitLab project/group)."
    },
    "velez_apiSetRunnerBuildkitRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "isBuildkitEnabled": {
          "type": "boolean"
        }
      }
    },
    "velez_apiSetRunnerBuildkitResponse": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string"
        }
      }
    },
    "velez_apiUpdateRunnerConfigRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "baseUrl": {
          "type": "string",
          "description": "Only a field the caller actually sets is persisted; each also decides\none bit of the response - see GetRunnerConfig.Response's doc comment\nfor what each value means."
        },
        "dockerImage": {
          "type": "string"
        },
        "dockerSocketAddress": {
          "type": "string",
          "description": "docker_socket_address - same tcp://-only validation as\nCreateRunner.Request.docker_socket_address. Setting it to \"\" clears it\nback to the default host socket grant."
        },
        "concurrent": {
          "type": "integer",
          "format": "int32",
          "description": "concurrent - must be at least 1. Unlike the other fields it is applied\nto the running container immediately."
        },
        "pullPolicy": {
          "$ref": "#/definitions/velez_apiRunnerPullPolicies",
          "description": "The fields below are applied live to config.toml and never stored in\nthe DB. A set field with an empty list / 0 / UNSPECIFIED clears the key."
        },
        "allowedPullPolicies": {
          "$ref": "#/definitions/velez_apiRunnerPullPolicies"
        },
        "checkInterval": {
          "type": "integer",
          "format": "int32"
        },
        "logLevel": {
          "$ref": "#/definitions/velez_apiRunnerLogLevel"
        },
        "shutdownTimeout": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "velez_apiUpdateRunnerConfigResponse": {
      "type": "object",
      "properties": {
        "requiresReregister": {
          "type": "boolean",
          "description": "requires_reregister - true when base_url and/or docker_image was set;\napply by calling ReregisterRunner."
        },
        "requiresRedeploy": {
          "type": "boolean",
          "description": "requires_redeploy - true when docker_socket_address was set; apply by\ncalling RedeployRunner."
        }
      }
    }
  }
}
