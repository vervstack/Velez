#!/bin/sh
set -e

echo "Running golangci-lint..."
golangci-lint run --fix ./...

# e2e (./tests/e2e/...) is intentionally excluded: it brings up a privileged
# DinD container per worktree and is far too slow for every commit. Run it
# manually when core logic changes — see the rule in CLAUDE.local.md.
echo "Running go test (excluding e2e)..."
go test $(go list ./... | grep -v '/tests/e2e')
