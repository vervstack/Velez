{
  "swagger": "2.0",
  "info": {
    "title": "container_registry_api.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "ContainerRegistryAPI",
      "description": "ContainerRegistryAPI - Container-Registry-as-a-Service. A registry\ninstance is a normal Velez service (velez.services /\ndeployment_specifications / deployments), with only the registry-specific\nfacts (port, ui_port, username, secret_ref) held in\nvelez.registry_instances - mirrors PostgresAPI exactly. See\ndocs/features/pgaas_and_registry_plugin.md section 3 for the shape this\nfollows, and internal/jobs/enable_registry.go for the plugin this\nreplaces."
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/api/container-registry/create": {
      "post": {
        "operationId": "ContainerRegistryAPI_CreateRegistryInstance",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/velez_apiCreateRegistryInstanceResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/googleRpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/velez_apiCreateRegistryInstanceRequest"
            }
          }
        ],
        "tags": [
          "ContainerRegistryAPI"
        ]
      }
    },
    "/api/container-registry/drop": {
      "post": {
        "operationId": "ContainerRegistryAPI_DropRegistryInstance",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/velez_apiDropRegistryInstanceResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/googleRpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/velez_apiDropRegistryInstanceRequest"
            }
          }
        ],
        "tags": [
          "ContainerRegistryAPI"
        ]
      }
    },
    "/api/container-registry/list": {
      "post": {
        "operationId": "ContainerRegistryAPI_ListRegistryInstances",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/velez_apiListRegistryInstancesResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/googleRpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/velez_apiListRegistryInstancesRequest"
            }
          }
        ],
        "tags": [
          "ContainerRegistryAPI"
        ]
      }
    },
    "/api/container-registry/{name}/credentials": {
      "get": {
        "summary": "GetRegistryInstanceCredentials is the only RPC that resolves a\nsecret_ref to its value.",
        "operationId": "ContainerRegistryAPI_GetRegistryInstanceCredentials",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/velez_apiGetRegistryInstanceCredentialsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/googleRpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "ContainerRegistryAPI"
        ]
      }
    }
  },
  "definitions": {
    "ProvisioningTaskJob": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/velez_apiProvisioningTaskStatus"
        }
      }
    },
    "googleRpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "velez_apiCreateRegistryInstanceRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "box": {
          "type": "string"
        },
        "exposeToPort": {
          "type": "integer",
          "format": "int64"
        },
        "ownerService": {
          "type": "string",
          "description": "owner_service - when set, a velez.service_resources binding is\nrecorded (owner_service, name, \"container_registry\") once the\ninstance is created."
        },
        "enableUi": {
          "type": "boolean",
          "description": "enable_ui - when set, deploys the joxit/docker-registry-ui sidecar\nalongside the registry itself. Disabled by default: most registries\nare pulled from by CI/CD and never browsed by a human."
        },
        "s3Storage": {
          "$ref": "#/definitions/velez_apiRegistryS3Storage",
          "description": "When set, blobs go to an S3 instance bucket instead of a local volume."
        }
      }
    },
    "velez_apiCreateRegistryInstanceResponse": {
      "type": "object",
      "properties": {
        "instance": {
          "$ref": "#/definitions/velez_apiRegistryInstance",
          "description": "instance is never populated - the RPC enqueues the\ncreate_registry_instance task and returns before it completes.\nCallers watch entity_id/action via TasksApi.WatchTask and refetch\nListRegistryInstances once the task reaches DONE."
        },
        "entityId": {
          "type": "string"
        },
        "action": {
          "type": "string"
        }
      }
    },
    "velez_apiDropRegistryInstanceRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      }
    },
    "velez_apiDropRegistryInstanceResponse": {
      "type": "object"
    },
    "velez_apiGetRegistryInstanceCredentialsResponse": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "registryUrl": {
          "type": "string"
        }
      }
    },
    "velez_apiListRegistryInstancesRequest": {
      "type": "object",
      "properties": {
        "paging": {
          "$ref": "#/definitions/velez_apiPaging"
        }
      }
    },
    "velez_apiListRegistryInstancesResponse": {
      "type": "object",
      "properties": {
        "instances": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/velez_apiRegistryInstance"
          }
        },
        "total": {
          "type": "string",
          "format": "uint64"
        },
        "provisioning": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/velez_apiProvisioningTask"
          }
        }
      }
    },
    "velez_apiPaging": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "string",
          "format": "uint64"
        },
        "offset": {
          "type": "string",
          "format": "uint64"
        }
      }
    },
    "velez_apiProvisioningTask": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string",
          "format": "int64"
        },
        "entityId": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/velez_apiProvisioningTaskStatus"
        },
        "error": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "jobs": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/ProvisioningTaskJob"
          }
        }
      },
      "description": "ProvisioningTask is an in-flight or recently failed create task of an AsAService\ninstance. List*Instances responses carry these so the UI can show provisioning\nprogress that survives a reload. Active until its task is DONE; FAILED ones stay\nuntil dismissed or 5 minutes old."
    },
    "velez_apiProvisioningTaskStatus": {
      "type": "string",
      "enum": [
        "STATUS_UNSPECIFIED",
        "PENDING",
        "RUNNING",
        "DONE",
        "FAILED"
      ],
      "default": "STATUS_UNSPECIFIED"
    },
    "velez_apiRegistryInstance": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "format": "int64"
        },
        "uiPort": {
          "type": "integer",
          "format": "int64",
          "description": "ui_port - the joxit/docker-registry-ui sidecar's own exposed port."
        },
        "username": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "ownerService": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "s3Instance": {
          "type": "string",
          "description": "Set when the registry stores blobs in a bucket of a Velez S3 instance\ninstead of a local volume. Read from the registry's own config."
        },
        "s3Bucket": {
          "type": "string"
        }
      },
      "description": "RegistryInstance never carries a password - status, environment, image,\ncontainer id and deploy history live on the underlying service/deployment\nrows and are read via ListSmerds/VervServicesService, not duplicated here."
    },
    "velez_apiRegistryS3Storage": {
      "type": "object",
      "properties": {
        "instanceName": {
          "type": "string"
        },
        "bucketName": {
          "type": "string",
          "description": "Absent means the registry instance name."
        }
      },
      "description": "RegistryS3Storage - store registry blobs in a bucket of a Velez S3\ninstance. Velez creates the bucket and a read/write key for the registry."
    }
  }
}
