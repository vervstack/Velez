  "definitions": {
    "googleRpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "velez_apiCreateRunnerRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "scope": {
          "$ref": "#/definitions/velez_apiRunnerScope"
        },
        "target": {
          "type": "string"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "environment": {
          "type": "string"
        },
        "dockerSocketAddress": {
          "type": "string",
          "description": "docker_socket_address - tcp:// address of a Docker daemon this runner\nshould talk to (set as DOCKER_HOST env) instead of the default host\nsocket. unix:// and bare paths are rejected: no caller-supplied value\nmay ever become a bind-mount source, so it can never be pointed at\nVelez's own host socket. Empty means Velez grants the host socket via\nits existing internal-only bind-mount gate - full root access, the\ncurrent default behavior."
        },
        "github": {
          "$ref": "#/definitions/velez_apiGithubConfig"
        }
      }
    },
    "velez_apiCreateRunnerResponse": {
      "type": "object",
      "properties": {
        "runner": {
          "$ref": "#/definitions/velez_apiRunner"
        }
      }
    },
    "velez_apiDropRunnerRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      }
    },
    "velez_apiDropRunnerResponse": {
      "type": "object"
    },
    "velez_apiGithubConfig": {
      "type": "object",
      "properties": {
        "accessToken": {
          "type": "string",
          "description": "access_token - a GitHub PAT with permission to mint a runner\nregistration token for target. Never stored as given; see\ninternal/service/secrets."
        }
      },
      "description": "GithubConfig - GitHub Actions-specific CreateRunner body. A future\nGitlabConfig (base_url + token) is a new message + new provider_config\ncase, never a change to this one."
    },
    "velez_apiListRunnersRequest": {
      "type": "object",
      "properties": {
        "paging": {
          "$ref": "#/definitions/velez_apiPaging"
        }
      }
    },
    "velez_apiListRunnersResponse": {
      "type": "object",
      "properties": {
        "runners": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/velez_apiRunner"
          }
        },
        "total": {
          "type": "string",
          "format": "uint64"
        }
      }
    },
    "velez_apiPaging": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "string",
          "format": "uint64"
        },
        "offset": {
          "type": "string",
          "format": "uint64"
        }
      }
    },
    "velez_apiRunner": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "provider": {
          "$ref": "#/definitions/velez_apiRunnerProvider"
        },
        "scope": {
          "$ref": "#/definitions/velez_apiRunnerScope"
        },
        "target": {
          "type": "string",
          "description": "target - the repo (\"owner/repo\") or org (\"owner\") the runner registers\nagainst, per scope."
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "environment": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "description": "Runner never carries its access token - status and environment live on the\nunderlying service/deployment rows and are read via ListSmerds/\nVervServicesService, not duplicated here."
    },
    "velez_apiRunnerProvider": {
      "type": "string",
      "enum": [
        "RUNNER_PROVIDER_UNSPECIFIED",
        "GITHUB"
      ],
      "default": "RUNNER_PROVIDER_UNSPECIFIED",
      "description": "RunnerProvider - which CI system a runner registers against. Deliberately\nleft room to grow: GITHUB is the only provisionable provider today, GITLAB\nand others are added here as new values later, never as new contracts."
    },
    "velez_apiRunnerScope": {
      "type": "string",
      "enum": [
        "RUNNER_SCOPE_UNSPECIFIED",
        "REPO",
        "ORG"
      ],
      "default": "RUNNER_SCOPE_UNSPECIFIED",
      "description": "RunnerScope - the scope a self-hosted runner registers under: a single\nrepository, or an entire organization/group. Generalizes across providers\n(GitHub repo/org, GitLab project/group)."
    }
  }
}
