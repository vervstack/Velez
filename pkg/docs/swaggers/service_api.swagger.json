  "definitions": {
    "ContainerHardware": {
      "type": "object",
      "properties": {
        "cpu": {
          "type": "number",
          "format": "float",
          "title": "Top level cpu share amount.\n0.5 - give half a core\n1 - allocates 1 core exactly\n2 - allocates 2 cores"
        },
        "ramMb": {
          "type": "integer",
          "format": "int64"
        },
        "memorySwapMb": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "ContainerHealthcheck": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "title": "if command is not presented,\nvelez will simply\nwait \"retires\" times for \"interval_second\" seconds each time,\nuntil container get status Running"
        },
        "intervalSecond": {
          "type": "integer",
          "format": "int64"
        },
        "timeoutSecond": {
          "type": "integer",
          "format": "int64"
        },
        "retries": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "ContainerSettings": {
      "type": "object",
      "properties": {
        "ports": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/velez_apiPort"
          }
        },
        "network": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/velez_apiNetworkBind"
          }
        },
        "volumes": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/velez_apiVolume"
          }
        }
      }
    },
    "PortProtocol": {
      "type": "string",
      "enum": [
        "unknown",
        "tcp",
        "udp"
      ],
      "default": "unknown"
    },
    "RequestFromVervonomicon": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string",
          "description": "image - the image to deploy. The .verv/ descriptor baked into THIS\nimage is the one applied."
        }
      }
    },
    "RequestUpgrade": {
      "type": "object",
      "properties": {
        "deploymentId": {
          "type": "string",
          "format": "uint64",
          "title": "Id of deployment from which to perform upgrade from"
        },
        "image": {
          "type": "string",
          "title": "Options to upgrade from. All optional.\nIf none is passed - simply creates new deployment\nand restarts smerds"
        }
      }
    },
    "googleRpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "velez_apiAboutService": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "originalName": {
          "type": "string"
        },
        "env": {
          "type": "string"
        },
        "serviceType": {
          "type": "string"
        },
        "team": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "port": {
          "type": "string"
        }
      }
    },
    "velez_apiBoundResource": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "resourceType": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      }
    },
    "velez_apiConfigFormat": {
      "type": "string",
      "enum": [
        "yaml",
        "env"
      ],
      "default": "yaml",
      "title": "- yaml: Default"
    },
    "velez_apiCreateDeployRequest": {
      "type": "object",
      "properties": {
        "new": {
          "$ref": "#/definitions/velez_apiCreateSmerdRequest",
          "title": "Creates new deployment specification"
        },
        "upgrade": {
          "$ref": "#/definitions/RequestUpgrade",
          "title": "Takes current version and upgrades\nonly certain part of it (image)"
        },
        "vervonomicon": {
          "$ref": "#/definitions/RequestFromVervonomicon",
          "description": "Deploys from the .verv/ descriptor baked into the given image."
        },
        "serviceName": {
          "type": "string"
        },
        "environment": {
          "type": "string",
          "description": "environment - the isolated namespace this operation targets. Required;\nvalidated in the service layer, not here (proto3 has no `required`\nkeyword)."
        }
      }
    },
    "velez_apiCreateDeployResponse": {
      "type": "object"
    },
    "velez_apiCreateServiceRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "environment": {
          "type": "string",
          "description": "environment - the isolated namespace this operation targets. Required;\nvalidated in the service layer, not here (proto3 has no `required`\nkeyword)."
        }
      }
    },
    "velez_apiCreateServiceResponse": {
      "type": "object"
    },
    "velez_apiCreateSmerdRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "imageName": {
          "type": "string"
        },
        "hardware": {
          "$ref": "#/definitions/ContainerHardware"
        },
        "settings": {
          "$ref": "#/definitions/ContainerSettings"
        },
        "command": {
          "type": "string"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "healthcheck": {
          "$ref": "#/definitions/ContainerHealthcheck"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "ignoreConfig": {
          "type": "boolean"
        },
        "useImagePorts": {
          "type": "boolean"
        },
        "autoUpgrade": {
          "type": "boolean"
        },
        "restart": {
          "$ref": "#/definitions/velez_apiRestartPolicy"
        },
        "verv": {
          "$ref": "#/definitions/velez_apiMatreshkaConfigSpec",
          "description": "verv and plain are independent and may both be set at once: verv is\nfetched/applied first, then plain's files are mounted on top - they no\nlonger form a mutually-exclusive oneof."
        },
        "isDeclarativeDeploy": {
          "type": "boolean",
          "description": "False (default):\n     if defined smerd already exist - api call fails\nTrue:\n     if smerd already exist and healthy\n     this api call won't fail.\nTODO maybe even support to upgrade to presented state will be implemented some day",
          "title": "is_declarative_deploy - flag allows caller to manage idempotency of calls"
        },
        "plain": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/velez_apiFileConfig"
          }
        },
        "environment": {
          "type": "string",
          "description": "environment - the isolated namespace this operation targets (not to be\nconfused with the env map above, which is container env vars).\nRequired; validated in the service layer, not here (proto3 has no\n`required` keyword)."
        },
        "repo": {
          "type": "string",
          "description": "repo - git repository URL this app's source lives in. Optional;\npurely reference metadata today, stamped onto the container as\nlabels.RepoLabel - no build-from-git behavior yet."
        }
      }
    },
    "velez_apiDeploymentInfo": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uint64"
        },
        "status": {
          "$ref": "#/definitions/velez_apiDeploymentStatus"
        },
        "specId": {
          "type": "string",
          "format": "uint64"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "image": {
          "type": "string"
        },
        "triggeredBy": {
          "type": "string"
        },
        "imageDigest": {
          "type": "string"
        }
      }
    },
    "velez_apiDeploymentStatus": {
      "type": "string",
      "enum": [
        "DEPLOYMENT_STATUS_UNKNOWN",
        "SCHEDULED_DEPLOYMENT",
        "SCHEDULED_DELETION",
        "SCHEDULED_UPGRADE",
        "RUNNING",
        "FAILED",
        "DELETED",
        "STOPPED"
      ],
      "default": "DEPLOYMENT_STATUS_UNKNOWN"
    },
    "velez_apiDescriptorFile": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "title": "path - relative to .verv/, e.g. \"vervonomicon.yaml\" or \"prod/ingress.conf\""
        },
        "content": {
          "type": "string",
          "format": "byte"
        }
      }
    },
    "velez_apiFileConfig": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "title": "target path inside container"
        },
        "content": {
          "type": "string",
          "format": "byte",
          "title": "raw file content"
        }
      }
    },
    "velez_apiGetServiceEnvironmentsRequest": {
      "type": "object",
      "properties": {
        "serviceName": {
          "type": "string"
        }
      }
    },
