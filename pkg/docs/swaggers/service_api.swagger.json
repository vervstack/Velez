        "callers": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/velez_apiServiceDependencyInfo"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/velez_apiServiceDependencyInfo"
          }
        }
      }
