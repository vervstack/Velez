          "type": "string"
        }
      }
    },
    "velez_apiCancelTransferResponse": {
      "type": "object"
    },
    "velez_apiCreateTransferTokenRequest": {
      "type": "object"
    },
    "velez_apiCreateTransferTokenResponse": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "title": "single-use, shown once"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "velez_apiListTransfersRequest": {
      "type": "object"
    },
    "velez_apiListTransfersResponse": {
      "type": "object",
      "properties": {
        "transfers": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/velez_apiTransferInfo"
          }
        }
      }
    },
    "velez_apiPlanTransferRequest": {
      "type": "object",
      "properties": {
        "containerName": {
          "type": "string"
        }
      }
    },
    "velez_apiPlanTransferResponse": {
      "type": "object",
      "properties": {
        "sidecars": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/PlanTransferSidecarCandidate"
          }
        },
        "consumers": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/PlanTransferNetworkConsumer"
          },
          "title": "other containers on the same docker networks"
        },
        "unsupportedMounts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "host bind mounts: block the move"
        }
      }
    },
    "velez_apiStartTransferRequest": {
      "type": "object",
      "properties": {
        "containerName": {
          "type": "string"
        },
        "sidecarNames": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "user-selected subset"
        },
        "address": {
          "type": "string",
          "title": "host:port of target Velez"
        },
        "token": {
          "type": "string",
          "title": "target-issued transfer token"
        },
        "isConsumersAcknowledged": {
          "type": "boolean",
          "title": "required when plan listed consumers"
        }
      }
    },
    "velez_apiStartTransferResponse": {
      "type": "object",
      "properties": {
        "transferId": {
          "type": "string"
        }
      }
    },
    "velez_apiTransferInfo": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "isSource": {
          "type": "boolean"
        },
        "containerName": {
          "type": "string"
        },
        "peerAddress": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/velez_apiTransferStatus"
        },
        "error": {
          "type": "string"
        },
        "totalBytes": {
          "type": "string",
          "format": "int64"
        },
        "doneBytes": {
          "type": "string",
          "format": "int64"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "velez_apiTransferStatus": {
      "type": "string",
      "enum": [
        "TRANSFER_STATUS_UNSPECIFIED",
        "TRANSFER_STATUS_PENDING",
        "TRANSFER_STATUS_RUNNING",
        "TRANSFER_STATUS_FAILED",
        "TRANSFER_STATUS_DONE",
        "TRANSFER_STATUS_CANCELLED"
      ],
      "default": "TRANSFER_STATUS_UNSPECIFIED"
    }
