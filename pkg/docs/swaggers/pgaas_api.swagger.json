{
  "swagger": "2.0",
  "info": {
    "title": "pgaas_api.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "PostgresAPI",
      "description": "PostgresAPI - Postgres-as-a-Service. A PG instance is a normal Velez\nservice (velez.services / deployment_specifications / deployments), with\nonly the pg-specific facts (db_name, username, secret_ref, port) held in\nvelez.pg_instances. See docs/features/pgaas_and_registry_plugin.md\nsection 3."
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/api/postgres/create": {
      "post": {
        "operationId": "PostgresAPI_CreatePgInstance",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/velez_apiCreatePgInstanceResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/googleRpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/velez_apiCreatePgInstanceRequest"
            }
          }
        ],
        "tags": [
          "PostgresAPI"
        ]
      }
    },
    "/api/postgres/drop": {
      "post": {
        "operationId": "PostgresAPI_DropPgInstance",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/velez_apiDropPgInstanceResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/googleRpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/velez_apiDropPgInstanceRequest"
            }
          }
        ],
        "tags": [
          "PostgresAPI"
        ]
      }
    },
    "/api/postgres/list": {
      "post": {
        "operationId": "PostgresAPI_ListPgInstances",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/velez_apiListPgInstancesResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/googleRpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/velez_apiListPgInstancesRequest"
            }
          }
        ],
        "tags": [
          "PostgresAPI"
        ]
      }
    },
    "/api/postgres/{name}/credentials": {
      "get": {
        "summary": "GetPgInstanceCredentials is the only RPC that resolves a secret_ref to\nits value.",
        "operationId": "PostgresAPI_GetPgInstanceCredentials",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/velez_apiGetPgInstanceCredentialsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/googleRpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "PostgresAPI"
        ]
      }
    }
  },
  "definitions": {
    "ProvisioningTaskJob": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/velez_apiProvisioningTaskStatus"
        }
      }
    },
    "googleRpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "velez_apiCreatePgInstanceRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "box": {
          "type": "string"
        },
        "exposeToPort": {
          "type": "integer",
          "format": "int64"
        },
        "ownerService": {
          "type": "string",
          "description": "owner_service - when set, a velez.service_resources binding is\nrecorded (owner_service, name, \"postgres\") once the instance is\ncreated."
        }
      }
    },
    "velez_apiCreatePgInstanceResponse": {
      "type": "object",
      "properties": {
        "instance": {
          "$ref": "#/definitions/velez_apiPgInstance",
          "description": "instance is never populated - the RPC enqueues the\ncreate_pg_instance task and returns before it completes.\nCallers watch entity_id/action via TasksApi.WatchTask and refetch\nListPgInstances once the task reaches DONE."
        },
        "entityId": {
          "type": "string"
        },
        "action": {
          "type": "string"
        }
      }
    },
    "velez_apiDropPgInstanceRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      }
    },
    "velez_apiDropPgInstanceResponse": {
      "type": "object"
    },
    "velez_apiGetPgInstanceCredentialsResponse": {
      "type": "object",
      "properties": {
        "dbName": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "dsn": {
          "type": "string"
        }
      }
    },
    "velez_apiListPgInstancesRequest": {
      "type": "object",
      "properties": {
        "paging": {
          "$ref": "#/definitions/velez_apiPaging"
        }
      }
    },
    "velez_apiListPgInstancesResponse": {
      "type": "object",
      "properties": {
        "instances": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/velez_apiPgInstance"
          }
        },
        "total": {
          "type": "string",
          "format": "uint64"
        },
        "provisioning": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/velez_apiProvisioningTask"
          }
        }
      }
    },
    "velez_apiPaging": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "string",
          "format": "uint64"
        },
        "offset": {
          "type": "string",
          "format": "uint64"
        }
      }
    },
    "velez_apiPgInstance": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "dbName": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "format": "int64"
        },
        "environment": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "ownerService": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "description": "PgInstance never carries a password - status, environment, image,\ncontainer id and deploy history live on the underlying service/deployment\nrows and are read via ListSmerds/VervServicesService, not duplicated here."
    },
    "velez_apiProvisioningTask": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string",
          "format": "int64"
        },
        "entityId": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/velez_apiProvisioningTaskStatus"
        },
        "error": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "jobs": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/ProvisioningTaskJob"
          }
        }
      },
      "description": "ProvisioningTask is an in-flight or recently failed create task of an AsAService\ninstance. List*Instances responses carry these so the UI can show provisioning\nprogress that survives a reload. Active until its task is DONE; FAILED ones stay\nuntil dismissed or 5 minutes old."
    },
    "velez_apiProvisioningTaskStatus": {
      "type": "string",
      "enum": [
        "STATUS_UNSPECIFIED",
        "PENDING",
        "RUNNING",
        "DONE",
        "FAILED"
      ],
      "default": "STATUS_UNSPECIFIED"
    }
  }
}
