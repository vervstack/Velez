  "definitions": {
    "ContainerHardware": {
      "type": "object",
      "properties": {
        "cpu": {
          "type": "number",
          "format": "float",
          "title": "Top level cpu share amount.\n0.5 - give half a core\n1 - allocates 1 core exactly\n2 - allocates 2 cores"
        },
        "ramMb": {
          "type": "integer",
          "format": "int64"
        },
        "memorySwapMb": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "ContainerHealthcheck": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "title": "if command or exec is presented,\nvelez waits \"retires\" times for \"interval_second\" seconds each time,\nuntil docker reports the container healthy.\nif neither is presented, velez waits the same way\nuntil container get status Running"
        },
        "intervalSecond": {
          "type": "integer",
          "format": "int64"
        },
        "timeoutSecond": {
          "type": "integer",
          "format": "int64"
        },
        "retries": {
          "type": "integer",
          "format": "int64"
        },
        "exec": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "exec form: run without a shell (for images with no shell). Wins over command"
        }
      }
    },
    "PortProtocol": {
      "type": "string",
      "enum": [
        "unknown",
        "tcp",
        "udp"
      ],
      "default": "unknown"
    },
    "RequestBindMountLink": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "title": "host path of the bind mount being linked"
        },
        "volumeName": {
          "type": "string",
          "title": "default: derived from service name + container target path"
        }
      }
    },
    "RequestGenericPattern": {
      "type": "object"
    },
    "RequestPgPattern": {
      "type": "object",
      "properties": {
        "superuser": {
          "type": "string",
          "description": "superuser/password are required when the container env carries no admin login."
        },
        "password": {
          "type": "string"
        }
      }
    },
    "RequestRegistryPattern": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "description": "username/password are the registry's existing htpasswd login, required when the container is\nconfigured with htpasswd auth. Velez tests a real login before changing anything."
        },
        "password": {
          "type": "string"
        }
      }
    },
    "RequestRunnerPattern": {
      "type": "object",
      "properties": {
        "provider": {
          "$ref": "#/definitions/velez_apiRunnerProvider",
          "description": "target is required: \"owner/repo\" (REPO scope), an org name (ORG scope) or a GitLab target.\nEverything else is prefilled by the client from DockerContainer.suggested_runner_defaults."
        },
        "scope": {
          "$ref": "#/definitions/velez_apiRunnerScope"
        },
        "target": {
          "type": "string"
        },
        "baseUrl": {
          "type": "string"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dockerImage": {
          "type": "string"
        },
        "concurrent": {
          "type": "integer",
          "format": "int32"
        },
        "accessToken": {
          "type": "string",
          "description": "access_token is only needed to deregister or mint tokens later."
        },
        "registrationToken": {
          "type": "string",
          "description": "registration_token is taken from the container env when omitted."
        }
      }
    },
    "ResponseError": {
      "type": "object",
      "properties": {
        "uuid": {
          "type": "string"
        },
        "cause": {
          "type": "string"
        }
      }
    },
    "ResponseValue": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string"
        },
        "err": {
          "type": "string"
        }
      }
    },
    "googleRpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "velez_apiAssembleConfigRequest": {
      "type": "object",
      "properties": {
        "imageName": {
          "type": "string"
        },
        "serviceName": {
          "type": "string"
        }
      }
    },
    "velez_apiAssembleConfigResponse": {
      "type": "object",
      "properties": {
        "config": {
          "type": "string",
          "format": "byte"
        }
      }
    },
    "velez_apiBreakConnectionsRequest": {
      "type": "object",
      "properties": {
        "connections": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/velez_apiConnection"
          }
        }
      }
    },
    "velez_apiBreakConnectionsResponse": {
      "type": "object"
    },
    "velez_apiConfigFormat": {
      "type": "string",
      "enum": [
        "yaml",
        "env"
      ],
      "default": "yaml",
      "description": "- yaml: Default"
    },
    "velez_apiConnection": {
      "type": "object",
      "properties": {
        "serviceName": {
          "type": "string"
        },
        "targetNetwork": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "environment": {
          "type": "string",
          "description": "environment - the isolated namespace this connection targets. Optional;\nempty resolves to the default environment (unchanged behavior for\nexisting callers). Mirrors DropSmerd.Request.environment."
        }
      }
    },
    "velez_apiContainerFilter": {
      "type": "object",
      "properties": {
        "field": {
          "$ref": "#/definitions/velez_apiContainerFilterField"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "velez_apiContainerFilterField": {
      "type": "string",
      "enum": [
        "unspecified",
        "service"
      ],
      "default": "unspecified",
      "description": "ContainerFilterField names which field of a ContainerFilter to match on.\nAdding a new field later just adds a new enum value here - an older\nserver ignores a filter field it doesn't recognize instead of erroring,\nsee container_manager.matchesContainerFilter's default case.\n\n - service: service - matches ContainerFilter.value as a case-insensitive substring\nof the container's resolved display name."
    },
    "velez_apiContainerSettings": {
      "type": "object",
      "properties": {
        "ports": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/velez_apiPort"
          }
        },
        "network": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/velez_apiNetworkBind"
          }
        },
        "volumes": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/velez_apiVolume"
          }
        }
      }
    },
    "velez_apiCreateSmerdRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "imageName": {
          "type": "string"
        },
        "hardware": {
          "$ref": "#/definitions/ContainerHardware"
        },
        "settings": {
          "$ref": "#/definitions/velez_apiContainerSettings"
        },
        "command": {
          "type": "string"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "healthcheck": {
          "$ref": "#/definitions/ContainerHealthcheck"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "ignoreConfig": {
          "type": "boolean"
        },
        "useImagePorts": {
          "type": "boolean"
        },
        "autoUpgrade": {
          "type": "boolean"
        },
        "restart": {
          "$ref": "#/definitions/velez_apiRestartPolicy"
        },
        "verv": {
          "$ref": "#/definitions/velez_apiMatreshkaConfigSpec",
          "description": "verv and plain are independent and may both be set at once: verv is\nfetched/applied first, then plain's files are mounted on top - they no\nlonger form a mutually-exclusive oneof."
        },
        "isDeclarativeDeploy": {
          "type": "boolean",
          "description": "False (default):\n     if defined smerd already exist - api call fails\nTrue:\n     if smerd already exist and healthy\n     this api call won't fail.\nTODO maybe even support to upgrade to presented state will be implemented some day",
          "title": "is_declarative_deploy - flag allows caller to manage idempotency of calls"
        },
        "plain": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/velez_apiFileConfig"
          }
        },
        "environment": {
          "type": "string",
          "description": "environment - the isolated namespace this operation targets (not to be\nconfused with the env map above, which is container env vars).\nRequired; validated in the service layer, not here (proto3 has no\n`required` keyword)."
        },
        "repo": {
          "type": "string",
          "description": "repo - git repository URL this app's source lives in. Optional;\npurely reference metadata today, stamped onto the container as\nlabels.RepoLabel - no build-from-git behavior yet."
        }
      }
    },
    "velez_apiDockerContainer": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "imageName": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/velez_apiSmerdStatus"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/velez_apiPort"
          }
        },
        "networks": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/velez_apiNetworkBind"
          }
        },
        "mounts": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/velez_apiMount"
          }
        },
        "isRegistered": {
          "type": "boolean"
        },
        "linkedServiceName": {
          "type": "string"
        },
        "suggestedPattern": {
          "$ref": "#/definitions/velez_apiServicePattern"
        },
        "suggestedRunnerDefaults": {
          "$ref": "#/definitions/velez_apiSuggestedRunnerDefaults"
        },
        "networkOwnerContainerId": {
          "type": "string",
          "description": "Id of the root container whose network namespace this container shares (resolved through chains). Unset for a root or standalone container."
        },
        "replacedByContainerId": {
          "type": "string",
          "description": "Id of the container that replaced this one when it was onboarded. Set on the old container while it waits for FinishOnboarding."
        }
      }
    },
    "velez_apiDropSmerdRequest": {
      "type": "object",
      "properties": {
        "uuids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "name": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "environment": {
          "type": "string",
          "description": "environment - the isolated namespace this operation targets. Required;\nvalidated in the service layer, not here (proto3 has no `required`\nkeyword)."
        }
      }
    },
    "velez_apiDropSmerdResponse": {
      "type": "object",
      "properties": {
        "failed": {
          "type": "array",
