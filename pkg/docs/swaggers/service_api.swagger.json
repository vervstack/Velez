            "$ref": "#/definitions/velez_apiBoundResource"
          }
        }
      }
    },
    "velez_apiGetServiceResponse": {
      "type": "object",
      "properties": {
        "vervService": {
          "$ref": "#/definitions/velez_apiVervAppService",
          "title": "in future there might be other service types that needs to be managed"
        },
        "about": {
          "$ref": "#/definitions/velez_apiAboutService"
        }
      }
    },
    "velez_apiGetVervonomiconRequest": {
      "type": "object",
      "properties": {
        "serviceName": {
          "type": "string"
        },
        "environment": {
          "type": "string",
          "description": "environment - which overlay to resolve. Empty resolves the default environment."
        }
      }
    },
    "velez_apiGetVervonomiconResponse": {
      "type": "object",
      "properties": {
        "raw": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/velez_apiDescriptorFile"
          },
          "description": "raw - every file found under .verv/, as found, before overlay merging."
        },
        "resolvedYaml": {
          "type": "string",
          "description": "resolved_yaml - the descriptor after overlay merge and box resolution."
        },
        "source": {
          "$ref": "#/definitions/velez_apiVervonomiconSource"
        },
        "environment": {
          "type": "string"
        },
        "resourceStatuses": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/velez_apiResourceReconciliation"
          },
          "description": "resource_statuses - one entry per resources.yaml resource, whether the\nservice already has a connection to it or still needs one provisioned."
        }
      }
