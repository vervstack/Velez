{
  "swagger": "2.0",
  "info": {
    "title": "runners_api.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "RunnersAPI"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/api/runners/create": {
      "post": {
        "operationId": "RunnersAPI_CreateRunner",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/velez_apiCreateRunnerResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/googleRpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/velez_apiCreateRunnerRequest"
            }
          }
        ],
        "tags": [
          "RunnersAPI"
        ]
      }
    },
    "/api/runners/drop": {
      "post": {
        "operationId": "RunnersAPI_DropRunner",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/velez_apiDropRunnerResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/googleRpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/velez_apiDropRunnerRequest"
            }
          }
        ],
        "tags": [
          "RunnersAPI"
        ]
      }
    },
    "/api/runners/list": {
      "post": {
        "operationId": "RunnersAPI_ListRunners",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/velez_apiListRunnersResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/googleRpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/velez_apiListRunnersRequest"
            }
          }
        ],
        "tags": [
          "RunnersAPI"
        ]
      }
    },
    "/api/runners/{name}/credentials": {
      "get": {
        "summary": "GetRunnerCredentials is the only RPC that resolves a secret_ref to its\nvalue. GitLab runners register manually in v1 (the official\ngitlab/gitlab-runner image doesn't self-register from env vars alone),\nso the response also carries the exact `gitlab-runner register` command\nthe caller runs by hand.",
        "operationId": "RunnersAPI_GetRunnerCredentials",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/velez_apiGetRunnerCredentialsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/googleRpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "RunnersAPI"
        ]
      }
    }
  },
  "definitions": {
    "googleRpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "velez_apiCreateRunnerRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "scope": {
          "$ref": "#/definitions/velez_apiRunnerScope"
        },
        "target": {
          "type": "string"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "environment": {
          "type": "string"
        },
        "dockerSocketAddress": {
          "type": "string",
          "description": "docker_socket_address - tcp:// address of a Docker daemon this runner\nshould talk to (set as DOCKER_HOST env) instead of the default host\nsocket. unix:// and bare paths are rejected: no caller-supplied value\nmay ever become a bind-mount source, so it can never be pointed at\nVelez's own host socket. Empty means Velez grants the host socket via\nits existing internal-only bind-mount gate - full root access, the\ncurrent default behavior."
        },
        "github": {
          "$ref": "#/definitions/velez_apiGithubConfig"
        },
        "gitlab": {
          "$ref": "#/definitions/velez_apiGitlabConfig"
        }
      }
    },
    "velez_apiCreateRunnerResponse": {
      "type": "object",
      "properties": {
        "runner": {
          "$ref": "#/definitions/velez_apiRunner",
          "description": "runner is never populated - the RPC enqueues the create_runner task\nand returns before it completes. Callers watch entity_id/action via\nTasksApi.WatchTask and refetch ListRunners once the task reaches DONE."
        },
        "entityId": {
          "type": "string"
        },
        "action": {
          "type": "string"
        }
      }
    },
    "velez_apiDropRunnerRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      }
    },
    "velez_apiDropRunnerResponse": {
      "type": "object"
    },
    "velez_apiGetRunnerCredentialsResponse": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "description": "token - the provider registration token stored at CreateRunner time\n(GitHub: minted from the caller's PAT; GitLab: the caller's access\ntoken, trusted as-is in v1). Not re-mintable through this RPC; it\nreflects the token stored then."
        },
        "target": {
          "type": "string",
          "description": "target - the repo/org (or project/group) the token registers against."
        },
        "provider": {
          "$ref": "#/definitions/velez_apiRunnerProvider"
        },
        "registerCommand": {
          "type": "string",
          "description": "register_command - populated only for providers with no automated\nregistration step (GitLab in v1); empty for a self-registering\nprovider like GitHub."
        }
      }
    },
    "velez_apiGithubConfig": {
      "type": "object",
      "properties": {
        "accessToken": {
          "type": "string",
          "description": "access_token - a GitHub PAT with permission to mint a runner\nregistration token for target. Never stored as given; see\ninternal/service/secrets."
        }
      },
      "description": "GithubConfig - GitHub Actions-specific CreateRunner body."
    },
    "velez_apiGitlabConfig": {
      "type": "object",
      "properties": {
        "accessToken": {
          "type": "string",
          "description": "access_token - a GitLab runner registration token for target (project or\ngroup), created by the caller ahead of time. Never stored as given; see\ninternal/service/secrets."
        },
        "baseUrl": {
          "type": "string",
          "description": "base_url - the GitLab instance's base URL, e.g. \"https://gitlab.com\" or\na self-managed instance's URL. Empty defaults to \"https://gitlab.com\"."
        }
      },
      "description": "GitlabConfig - GitLab-specific CreateRunner body. v1 provisions a bare\nofficial gitlab/gitlab-runner container and stops there - there is no\nautomated `gitlab-runner register` step, so access_token is trusted as an\nalready-valid registration token and surfaced back via\nGetRunnerCredentials, not used to call any GitLab API."
    },
    "velez_apiListRunnersRequest": {
      "type": "object",
      "properties": {
        "paging": {
          "$ref": "#/definitions/velez_apiPaging"
        }
      }
    },
    "velez_apiListRunnersResponse": {
      "type": "object",
      "properties": {
        "runners": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/velez_apiRunner"
          }
        },
        "total": {
          "type": "string",
          "format": "uint64"
        }
      }
    },
    "velez_apiPaging": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "string",
          "format": "uint64"
        },
        "offset": {
          "type": "string",
          "format": "uint64"
        }
      }
    },
    "velez_apiRunner": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "provider": {
          "$ref": "#/definitions/velez_apiRunnerProvider"
        },
        "scope": {
          "$ref": "#/definitions/velez_apiRunnerScope"
        },
        "target": {
          "type": "string",
          "description": "target - the repo (\"owner/repo\") or org (\"owner\") the runner registers\nagainst, per scope."
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "environment": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "description": "Runner never carries its access token - status and environment live on the\nunderlying service/deployment rows and are read via ListSmerds/\nVervServicesService, not duplicated here."
    },
    "velez_apiRunnerProvider": {
      "type": "string",
      "enum": [
        "RUNNER_PROVIDER_UNSPECIFIED",
        "GITHUB",
        "GITLAB"
      ],
      "default": "RUNNER_PROVIDER_UNSPECIFIED",
      "description": "RunnerProvider - which CI system a runner registers against. GITHUB\nself-registers fully from env vars; GITLAB is provisioned as a bare\nofficial-image container and registers manually in v1 (see\nGetRunnerCredentials). Others are added here as new values later, never as\nnew contracts."
    },
    "velez_apiRunnerScope": {
      "type": "string",
      "enum": [
        "RUNNER_SCOPE_UNSPECIFIED",
        "REPO",
        "ORG"
      ],
      "default": "RUNNER_SCOPE_UNSPECIFIED",
      "description": "RunnerScope - the scope a self-hosted runner registers under: a single\nrepository, or an entire organization/group. Generalizes across providers\n(GitHub repo/org, GitLab project/group)."
    }
  }
}
