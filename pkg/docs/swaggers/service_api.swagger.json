    "velez_apiGetServiceMetricsResponse": {
      "type": "object",
      "properties": {
        "cpuPercent": {
          "type": "number",
          "format": "double"
        },
        "memMi": {
          "type": "string",
          "format": "uint64"
        },
        "memMaxMi": {
          "type": "string",
          "format": "uint64"
        },
        "replicasRunning": {
          "type": "integer",
          "format": "int64"
        },
        "replicasDesired": {
          "type": "integer",
          "format": "int64"
        },
        "uptimeSeconds": {
          "type": "string",
          "format": "uint64"
        }
      }
